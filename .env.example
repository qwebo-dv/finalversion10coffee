# Production database changes must go through `npm run payload:migrate`.
PAYLOAD_DB_PUSH=false

# Preview access for shop.10coffee.ru. Keep enabled until the retail shop launches.
# Only use while a private IP-only preview is actually needed. Search-engine
# indexing is controlled separately by the shop layout's noindex metadata.
SHOP_RESTRICT_ACCESS=false
# Comma-separated public IPv4/IPv6 addresses allowed to open /shop and shop.10coffee.ru.
SHOP_ALLOWED_IPS=203.0.113.10,2001:db8::10

# Canonical retail storefront and personal-cabinet URL. Individual customers
# are redirected here instead of the wholesale /dashboard.
SHOP_SITE_URL=https://shop.10coffee.ru/main

# Public Yandex JavaScript API key used by the official CDEK pickup-point map.
# Restrict the key in Yandex Developer Dashboard to https://shop.10coffee.ru/*.
NEXT_PUBLIC_CDEK_MAP_API_KEY=

# Server-side token for DaData address and company suggestions.
DADATA_API_KEY=

# Yandex Delivery across Russia. The safe default is the official test environment:
# it only accepts Moscow addresses and uses the public test token plus the recommended
# Moscow test PVS source from Yandex documentation.
# Never set YANDEX_DELIVERY_ENV=production until a real shipment has been verified.
# The API token must stay server-side and must not use NEXT_PUBLIC_. Package dimensions
# are filled per product variant in Payload and are not environment variables.
YANDEX_DELIVERY_ENV=test
# Temporary storefront preview: comma-separated trusted client IPs.
# Keep empty until the integration is ready for all buyers.
YANDEX_DELIVERY_PREVIEW_ALLOWED_IPS=
# Payload admins allowed to see the preview when their admin session cookie is
# available on the shop host. Comma-separated, empty disables email access.
YANDEX_DELIVERY_PREVIEW_ADMIN_EMAILS=cactusjacklaflamerrr@gmail.com
# Test and production credentials must never be mixed. In test mode the app
# uses Yandex's public test token and recommended Moscow PVS. Copy the public
# token from the official Yandex documentation into the deployment environment;
# never commit token values, including public test credentials, to Git.
YANDEX_DELIVERY_TEST_API_TOKEN=
# Optional override; when empty, the documented Moscow test PVS is used.
YANDEX_DELIVERY_TEST_SOURCE_STATION_ID=
# Production-only credentials from the Yandex Delivery cabinet. They are
# ignored while YANDEX_DELIVERY_ENV=test.
YANDEX_DELIVERY_API_TOKEN=
YANDEX_DELIVERY_SOURCE_STATION_ID=
# Set only if Yandex has explicitly registered a merchant for this integration.
YANDEX_DELIVERY_MERCHANT_ID=
YANDEX_DELIVERY_SENDER_INN=
# Used only until product variants receive their actual shipping data in Payload.
# Product dimensions and weight override these conservative fallback values.
YANDEX_DELIVERY_PACKAGE_LENGTH_CM=45
YANDEX_DELIVERY_PACKAGE_WIDTH_CM=30
YANDEX_DELIVERY_PACKAGE_HEIGHT_CM=20
YANDEX_DELIVERY_PACKAGE_TARE_GRAMS=100
YANDEX_DELIVERY_DEFAULT_ITEM_WEIGHT_GRAMS=1000

# Telegram Login (OIDC). Create a bot and register both the production origin
# and https://your-domain/api/auth/social/callback in @BotFather > Login Widget.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Loyalty notifications. Telegram delivery works only after the customer has
# started the bot. VK delivery needs a community token with messages access.
# Email delivery uses the SMTP Gmail adapter configured in payload.config.ts.
SMTP_EMAIL=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
VK_COMMUNITY_ACCESS_TOKEN=
VK_API_VERSION=5.199

# YooKassa acquiring is disabled until test credentials are configured.
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://shop.10coffee.ru/order/success
YOOKASSA_WEBHOOK_URL=https://shop.10coffee.ru/api/shop/payments/yookassa/webhook

# Required in production. The scheduler must send this value as
# `Authorization: Bearer ...` when invoking protected cron endpoints.
CRON_SECRET=

# Shared MoySklad credentials and fallback settings.
MOYSKLAD_ENABLED=false
MOYSKLAD_TOKEN=
MOYSKLAD_ORGANIZATION_ID=
MOYSKLAD_STORE_ID=
MOYSKLAD_DELIVERY_SERVICE_ID=
MOYSKLAD_SYNC_ORDERS_ON_CREATE=true

# B2B policy. Missing values fall back to the shared settings above.
MOYSKLAD_WHOLESALE_ORGANIZATION_ID=
MOYSKLAD_WHOLESALE_STORE_ID=
MOYSKLAD_WHOLESALE_DELIVERY_SERVICE_ID=
MOYSKLAD_WHOLESALE_SALES_CHANNEL_ID=
MOYSKLAD_WHOLESALE_SALES_CHANNEL_NAME=Сайт 10coffee — опт
# Enum МойСклад: для B2B по умолчанию используются прямые продажи.
MOYSKLAD_WHOLESALE_SALES_CHANNEL_TYPE=DIRECT_SALES
MOYSKLAD_WHOLESALE_PROJECT_ID=
MOYSKLAD_WHOLESALE_CONTRACT_ID=
MOYSKLAD_WHOLESALE_ORDER_STATE_NEW_ID=
MOYSKLAD_WHOLESALE_CREATE_INVOICE_ON_ORDER=true

# B2C policy. Retail invoices are disabled by default.
MOYSKLAD_RETAIL_ORGANIZATION_ID=
MOYSKLAD_RETAIL_STORE_ID=
MOYSKLAD_RETAIL_DELIVERY_SERVICE_ID=
MOYSKLAD_RETAIL_SALES_CHANNEL_ID=
MOYSKLAD_RETAIL_SALES_CHANNEL_NAME=Сайт 10coffee — розница
# Розничный сайт является интернет-магазином, а не POS-точкой.
MOYSKLAD_RETAIL_SALES_CHANNEL_TYPE=ECOMMERCE
MOYSKLAD_RETAIL_PROJECT_ID=
MOYSKLAD_RETAIL_CONTRACT_ID=
MOYSKLAD_RETAIL_ORDER_STATE_NEW_ID=
MOYSKLAD_RETAIL_CREATE_INVOICE_ON_ORDER=false
