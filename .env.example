# Preview access for shop.10coffee.ru. Keep enabled until the retail shop launches.
SHOP_PREVIEW_ENABLED=true
# Comma-separated public IPv4/IPv6 addresses allowed to open /shop and shop.10coffee.ru.
SHOP_ALLOWED_IPS=203.0.113.10,2001:db8::10

# Sber acquiring is disabled until production credentials are issued.
SBER_ACQUIRING_ENABLED=false
SBER_ACQUIRING_API_URL=https://ecommerce.sberbank.ru/ecomm/gw/partner/api/v1
SBER_ACQUIRING_USERNAME=
SBER_ACQUIRING_PASSWORD=
SBER_ACQUIRING_RETURN_URL=https://shop.10coffee.ru/order/success
SBER_ACQUIRING_FAIL_URL=https://shop.10coffee.ru/order/failed
