# Production database changes must go through `npm run payload:migrate`.
PAYLOAD_DB_PUSH=false

# Preview access for shop.10coffee.ru. Keep enabled until the retail shop launches.
# Only use while a private IP-only preview is actually needed. Search-engine
# indexing is controlled separately by the shop layout's noindex metadata.
SHOP_RESTRICT_ACCESS=false
# Comma-separated public IPv4/IPv6 addresses allowed to open /shop and shop.10coffee.ru.
SHOP_ALLOWED_IPS=203.0.113.10,2001:db8::10

# Canonical retail storefront and personal-cabinet URL. Individual customers
# are redirected here instead of the wholesale /dashboard.
SHOP_SITE_URL=https://shop.10coffee.ru/main

# Public Yandex JavaScript API key used by the official CDEK pickup-point map.
# Restrict the key in Yandex Developer Dashboard to https://shop.10coffee.ru/*.
NEXT_PUBLIC_CDEK_MAP_API_KEY=

# Server-side token for DaData address and company suggestions.
DADATA_API_KEY=

# Telegram Login (OIDC). Create a bot and register both the production origin
# and https://your-domain/api/auth/social/callback in @BotFather > Login Widget.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# YooKassa acquiring is disabled until test credentials are configured.
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://shop.10coffee.ru/order/success
YOOKASSA_WEBHOOK_URL=https://shop.10coffee.ru/api/shop/payments/yookassa/webhook

# Required in production. Vercel sends this value as `Authorization: Bearer ...`
# when invoking protected cron endpoints.
CRON_SECRET=

# Shared MoySklad credentials and fallback settings.
MOYSKLAD_ENABLED=false
MOYSKLAD_TOKEN=
MOYSKLAD_ORGANIZATION_ID=
MOYSKLAD_STORE_ID=
MOYSKLAD_DELIVERY_SERVICE_ID=
MOYSKLAD_SYNC_ORDERS_ON_CREATE=true

# B2B policy. Missing values fall back to the shared settings above.
MOYSKLAD_WHOLESALE_ORGANIZATION_ID=
MOYSKLAD_WHOLESALE_STORE_ID=
MOYSKLAD_WHOLESALE_DELIVERY_SERVICE_ID=
MOYSKLAD_WHOLESALE_SALES_CHANNEL_ID=
MOYSKLAD_WHOLESALE_SALES_CHANNEL_NAME=Сайт 10coffee — опт
# Enum МойСклад: для B2B по умолчанию используются прямые продажи.
MOYSKLAD_WHOLESALE_SALES_CHANNEL_TYPE=DIRECT_SALES
MOYSKLAD_WHOLESALE_PROJECT_ID=
MOYSKLAD_WHOLESALE_CONTRACT_ID=
MOYSKLAD_WHOLESALE_ORDER_STATE_NEW_ID=
MOYSKLAD_WHOLESALE_CREATE_INVOICE_ON_ORDER=true

# B2C policy. Retail invoices are disabled by default.
MOYSKLAD_RETAIL_ORGANIZATION_ID=
MOYSKLAD_RETAIL_STORE_ID=
MOYSKLAD_RETAIL_DELIVERY_SERVICE_ID=
MOYSKLAD_RETAIL_SALES_CHANNEL_ID=
MOYSKLAD_RETAIL_SALES_CHANNEL_NAME=Сайт 10coffee — розница
# Розничный сайт является интернет-магазином, а не POS-точкой.
MOYSKLAD_RETAIL_SALES_CHANNEL_TYPE=ECOMMERCE
MOYSKLAD_RETAIL_PROJECT_ID=
MOYSKLAD_RETAIL_CONTRACT_ID=
MOYSKLAD_RETAIL_ORDER_STATE_NEW_ID=
MOYSKLAD_RETAIL_CREATE_INVOICE_ON_ORDER=false
